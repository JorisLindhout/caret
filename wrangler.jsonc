{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "caret",
  "compatibility_date": "2026-09-12",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  }
}
